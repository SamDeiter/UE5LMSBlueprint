his.updateVisuals(node);\n    this.updateVisuals(link.endPin.node);\n\n    // Redraw wires\n    requestAnimationFrame(() => {\n      this.app.graph.redrawNodeWires(link.startPin.node.id);\n      this.app.graph.redrawNodeWires(node.id);\n      this.app.graph.redrawNodeWires(link.endPin.node.id);\n    });\n\n    this.app.persistence.autoSave();\n  }\n}\n\nexport { WiringController };\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Sam Deiter\\Documents\\GitHub\\UE5LMSBlueprint\\src\\graph\\index.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Sam Deiter\\Documents\\GitHub\\UE5LMSBlueprint\\src\\graph\\node\\NodeWidgets.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Sam Deiter\\Documents\\GitHub\\UE5LMSBlueprint\\src\\macros\\MacroDefinition.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Sam Deiter\\Documents\\GitHub\\UE5LMSBlueprint\\src\\macros\\MacroRegistry.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Sam Deiter\\Documents\\GitHub\\UE5LMSBlueprint\\src\\registries\\NodeRegistry.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Sam Deiter\\Documents\\GitHub\\UE5LMSBlueprint\\src\\registries\\VirtualAssetRegistry.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDepreca
{
  "name": "ue5-blueprint-editor",
  "version": "1.0.0",
  "description": "UE5 Blueprint Editor Replica - Visual scripting interface",
  "homepage": "https://samdeiter.github.io/UE5LMSBlueprint/",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "echo \"Tests run in browser - open index.html and run window.runTests()\"",
    "serve": "python -m http.server 8000",
    "preview": "npm run serve && start http://localhost:8000",
    "check-sizes": "node scripts/file-size-monitor.js",
    "validate": "npm run lint && npm run check-sizes",
    "precommit": "npm run validate",
    "prepare": "husky",
    "deploy": "gh-pages -d ."
  },
  "keywords": [
    "blueprint",
    "visual-scripting",
    "unreal-engine"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.39.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7"
  }
}
